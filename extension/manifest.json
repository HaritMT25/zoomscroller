{
  "manifest_version": 3,
  "name": "ZoomScroller helper",
  "version": "1.0.0",
  "description": "Lets the ZoomScroller app pinch-zoom every page: sites can no longer block touch zoom with CSS. Mouse and touchpad unaffected.",
  "homepage_url": "https://github.com/HaritMT25/zoomscroller",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["touch.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
